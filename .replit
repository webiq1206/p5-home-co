modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "gce"
build = "npm run build"
# Migrations run at BOOT rather than at build, because the build environment
# does not carry the production DATABASE_URL - which is why the schema fell
# behind the code and /admin/finance/data-quality started returning a 500.
#
# Safe to run every time: the migrator records each file in schema_migration
# and skips it afterwards, and the SQL uses IF NOT EXISTS throughout.
#
# Deliberately `&&`. If a migration fails the app does NOT start, which is the
# correct outcome - a running app on a half-applied schema serves wrong numbers
# quietly, and quiet wrong numbers are worse than a site that is plainly down.
run = "npm run db:migrate && npm run start -- -H 0.0.0.0 -p ${PORT:-3000}"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -H 0.0.0.0 -p 3000"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example file holds variable NAMES ONLY and must be tracked,
# so anyone setting the project up knows what to provide.
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# Replit pnpm-workspace scaffold.
# This is a single-package Next.js App Router site, not a pnpm workspace.
# Replit's tooling has previously generated the paths below and committed
# them here, which broke the production build and required excluding them
# from tsconfig.json. Ignoring them means that if the tooling recreates
# them in the workspace, they stay out of the repository.
/lib/
/artifacts/
/scripts/
/pnpm-lock.yaml
/pnpm-workspace.yaml
/tsconfig.base.json
/.npmrc

# Keep only the marker that tells Replit the scaffold already ran, so it
# does not re-apply it. The rest of this folder is a duplicate copy of the
# project and must not be tracked.
/.migration-backup/*
!/.migration-backup/.scaffold-applied

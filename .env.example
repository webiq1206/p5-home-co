# P5 Home Co lead manager. Names only -- never commit real values.
# On Replit these belong in Secrets, not in a file.

# PostgreSQL connection string. Replit provisions this for the attached
# database; copy it from the Database pane. Required by the admin panel,
# the intake endpoint, and the watchdog.
DATABASE_URL=

# Shared secret the scheduler presents when calling /api/jobs/watchdog.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The endpoint refuses to run when this is unset.
WATCHDOG_SECRET=

# Google Workspace OAuth for admin sign-in. Create a Web application OAuth
# client in Google Cloud Console, with this authorized redirect URI:
#   https://p5homeco.com/api/auth/google/callback
# Set the consent screen to Internal so only P5 Workspace accounts can use it.
# Until both are set, /admin/login says sign-in is unconfigured.
#
# Access needs BOTH an approved P5 domain AND a matching active row in
# app_user. Owning a company address is not by itself access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Derived from the request origin when unset; set it only if the
# app is reached on a different host than Google was told about.
GOOGLE_OAUTH_REDIRECT_URI=

# HubSpot Service Key ("P5 Lead Manager", portal 247066159). Used by
# `npm run hubspot:setup` to create deal properties, and later by the CRM sync.
# Scopes: crm.objects.{contacts,deals}.read/write, crm.objects.owners.read,
# crm.schemas.deals.read/write. Rotate it in HubSpot if it is ever exposed.
HUBSPOT_TOKEN=

# The one account allowed to create itself as the first administrator, and
# only while no active administrator exists. Solves the chicken-and-egg of
# needing an app_user row to sign in, and needing to sign in to create one.
# Defaults to hello@p5homeco.com. Must still be on an approved P5 domain.
INITIAL_ADMIN_EMAIL=

# The watchdog runs in-process on an always-on host (Reserved VM), so no
# external scheduler is needed. Defaults on in production.
#   WATCHDOG_IN_PROCESS=false   disables it (use the HTTP endpoint instead)
#   WATCHDOG_IN_PROCESS=true    enables it in development
WATCHDOG_IN_PROCESS=
# Milliseconds between passes. Defaults to 300000 (five minutes).
WATCHDOG_INTERVAL_MS=

# --- Alert email -----------------------------------------------------------
# Without these, alerts are logged instead of sent, and the log says so.
# Gmail/Workspace: create an App Password for hello@p5homeco.com
# (Google Account -> Security -> 2-Step Verification -> App passwords) and use
# it as SMTP_PASSWORD. An App Password can send only, and can be revoked on its
# own -- which is why sign-in deliberately asks for no mail scope.
SMTP_USER=
SMTP_PASSWORD=
# Optional. Default smtp.gmail.com:465.
SMTP_HOST=
SMTP_PORT=
# Optional. Default "P5 Home Co <SMTP_USER>".
SMTP_FROM=

# Where alert emails link to. Default https://p5homeco.com
APP_BASE_URL=

# Maximum PostgreSQL connections per instance. Defaults to 5, which suits
# an autoscale deployment running many short-lived instances.
PGPOOL_MAX=

# --- Not connected during this project. Deliberately absent. ---
# Handoff and QuickBooks stay disabled behind feature flags; no credentials
# are requested and no requests are made while those flags are false.

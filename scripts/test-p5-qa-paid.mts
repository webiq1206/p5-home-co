 await assert.rejects(site.saveDraft(id,key,'p5',payload,0,'bounded-paid'),/atomic marker failure/);assert.equal((await db.query('SELECT id FROM p5_estimator_drafts WHERE id=$1',[id])).rows.length,0);
 await db.exec('DROP TRIGGER qa_atomic_fault ON p5_estimator_work');await site.saveDraft(id,key,'p5',payload,0,'bounded-paid');await remote.qa.provision([{tenant,project}]);

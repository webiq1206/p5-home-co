 server=makeServer(remote,{},config);
 const serve=(url:string,init:any)=>new Promise<Response>((resolve,reject)=>{const req:any=Readable.from(init?.body?[Buffer.from(init.body)]:[]);req.method=init.method||'GET';req.url=new URL(url).pathname;req.headers=Object.fromEntries(new Headers(init.headers));const res:any={writableEnded:false,destroyed:false,status:200,headers:{},writeHead(status:number,headers:any){this.status=status;this.headers=headers;},setHeader(k:string,v:string){this.headers[k]=v;},end(value:string){this.writableEnded=true;resolve(new Response(value,{status:this.status,headers:this.headers}));}};try{server.emit('request',req,res);}catch(e){reject(e);}});
 globalThis.fetch=async(input:any,init:any)=>{const url=String(input);if(!url.startsWith('https://qa-ledger.invalid/v1/projects/qa-paid-')){escaped++;throw Error('Unexpected network boundary '+new URL(url).origin);}brokerCalls++;assert.equal(new Headers(init?.headers).has('x-api-key'),false,'provider key is never forwarded');return serve(url,init);};

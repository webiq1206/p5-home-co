# Standalone database URL. Cohost launcher can reuse existing DATABASE_URL.
DOCUMENT_DATABASE_URL=
# Exactly these five authorized tenant IDs are supported. Populate each value
# with a different random server-only secret of at least 32 characters.
# Never copy a key between tenants or put one in NEXT_PUBLIC_* configuration.
P5_DOCUMENT_TENANTS_JSON={"p5homeco.com":"","boiseconstruction.co":"","boiseremodeling.co":"","boisehandyman.co":"","boisecabinet.co":""}
# Set true in the protected worker environment only after all five entries above
# have been provisioned and independently verified.
P5_DOCUMENT_REQUIRE_ALL_TENANTS=true
DOCUMENT_PROVIDER=anthropic
# Explicitly choose and benchmark an available model in your provider account.
DOCUMENT_MODEL=
DOCUMENT_VERIFY_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
PORT=8080
# These are conservative admission controls, not proof of a 60-second SLA.
# Raise them only to verified provider quotas and measured VM capacity.
DOCUMENT_PROVIDER_SLOTS=12
DOCUMENT_REQUESTS_PER_MINUTE=60
DOCUMENT_TOKENS_PER_MINUTE=600000
DOCUMENT_PARSER_SLOTS=2
# Idle response timeout; streamed Anthropic responses also have a hard total bound.
DOCUMENT_CALL_TIMEOUT_MS=40000
DOCUMENT_STREAM_TIMEOUT_MS=360000
DOCUMENT_PARSE_TIMEOUT_MS=60000
DOCUMENT_JOB_TIMEOUT_MS=900000
DOCUMENT_MAX_OUTPUT_TOKENS=10000
DOCUMENT_REVIEW_MAX_OUTPUT_TOKENS=32000
DOCUMENT_MAX_BYTES=262144000
DOCUMENT_MAX_PAGES=250
DOCUMENT_RETENTION_DAYS=30
DOCUMENT_TENANT_MAX_QUEUED=30
DOCUMENT_TENANT_STORAGE_BYTES=2147483648

# P5 cohosting only: opt-in, leave false until qualified.
P5_DOCUMENT_HOST_ENABLED=false
# Do not copy standalone concurrency/retention values above into cohost setup.
# See README for conservative cohost defaults and private port settings.
